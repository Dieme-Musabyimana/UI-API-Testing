{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": ["CUSTOMER", "ADMIN"]
    },
    "isVerified": {
      "type": "boolean"
    },
    "avatar": {
      "type": ["string", "null"]
    },
    "phone": {
      "type": ["string", "null"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "email",
    "firstName",
    "lastName",
    "role",
    "isVerified",
    "createdAt"
  ]
}