{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "name",
    "slug",
    "description",
    "price",
    "comparePrice",
    "rating",
    "reviewCount",
    "isFlashSale",
    "category",
    "images",
    "variants"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "comparePrice": {
      "type": [
        "number",
        "null"
      ]
    },
    "rating": {
      "type": "number"
    },
    "reviewCount": {
      "type": "integer"
    },
    "isFlashSale": {
      "type": "boolean"
    },
    "category": {
      "type": "object",
      "required": [
        "id",
        "name",
        "slug",
        "description",
        "image",
        "parentId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}