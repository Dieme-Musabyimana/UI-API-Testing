{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorResponse",
  "type": "object",
  "required": ["success", "message", "errors"],
  "properties": {
    "success": {
      "type": "boolean",
      "enum": [false]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}