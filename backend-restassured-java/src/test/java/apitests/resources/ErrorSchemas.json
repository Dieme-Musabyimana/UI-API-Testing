{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Error",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "example": false
    },
    "message": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": ["success", "message"]
}